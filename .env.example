BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstUVwxYz
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/joybot_db
REDIS_URL=redis://localhost:6379/0
JOYREACTOR_BASE_URL=https://joyreactor.cc
JOYREACTOR_API_URL=https://api.joyreactor.com/graphql
LOG_LEVEL=INFO
CACHE_RETENTION_HOURS=48
MAX_FRESH_POSTS_FOR_BATCH=20
INITIAL_ADMIN_IDS=[12345678,87654321]
DEFAULT_TIMEZONE=Europe/Minsk
API_REQUEST_INTERVAL=2.5
MAX_MEDIA_SIZE_MB=50
QUEUE_TYPE=memory# TLS_SNI_OVERRIDES=[]  # e.g. ["host.docker.internal:api.joyreactor.com"] for proxy testing
MEDIA_DIR=tmp/media

# Long posts (more than COLLAPSE_POST_THRESHOLD runs) are sent collapsed:
# only the first run is delivered, with a "Показать весь пост" button.
# Set to 0 to disable collapse entirely (always send the full post).
COLLAPSE_POST_THRESHOLD=3

# How long the in-process stash holds the deferred runs while the user is
# reading the preview. After this TTL the "show full" button stops working.
COLLAPSED_POST_STASH_TTL_SECONDS=3600
